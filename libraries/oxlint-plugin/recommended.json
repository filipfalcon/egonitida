{
  "jsPlugins": [{ "name": "nitida", "specifier": "@nitida/oxlint-plugin" }],
  "rules": {
    "nitida/pure-steps": "error",
    "nitida/no-nullable-components": "error",
    "nitida/views-keep-nothing": "error",
    "nitida/no-index-keys": "error",
    "nitida/no-three-in-domains": "error",
    "nitida/redacted-command-secrets": "error",
    "nitida/same-maths": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-non-null-assertion": "error"
  }
}
