{
  "name": "egonitida",
  "version": "0.0.0",
  "private": true,
  "description": "An engine for web applications, rendered by Three.js on WebGPU and written in Effect.",
  "workspaces": [
    "applications/*",
    "libraries/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "alchemy dev",
    "check": "vp check && npm run verify",
    "check:fix": "vp check --fix",
    "test": "vp test",
    "verify": "cd verification && lake build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.52.0",
    "@effect/vitest": "4.0.0",
    "@egonitida/oxlint-plugin": "*",
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.0",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-d1": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "@effect/vitest": "4.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  }
}
